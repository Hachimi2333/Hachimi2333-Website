# Cloudflare Workers static-asset headers.
# Copied verbatim from public/ into dist/ by Vite, then parsed by Workers.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Vite fingerprints every file under /assets/, so it is safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

# The SPA shell must be revalidated so a new deploy is picked up immediately.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
